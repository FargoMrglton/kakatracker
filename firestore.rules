rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'login', 'events', 'createdAt', 'durations', 'session'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24))
        && (!('events' in request.resource.data) || (request.resource.data.events is list && request.resource.data.events.size() <= 20000))
        && (!('durations' in request.resource.data) || (request.resource.data.durations is map && request.resource.data.durations.size() <= 20000))
        && (!('session' in request.resource.data) || request.resource.data.session is map);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /reactions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && id.matches('.*_' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner', 'ts', 'by', 'emoji', 'at'])
        && request.resource.data.emoji in ['👏', '😂', '🤢', '🔥', '💩'];
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
  }
}
